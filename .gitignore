# The repository is source: code, configs, docs, tests and small examples.
# Data, runs and large outputs live outside git. The label tables are published
# on Hugging Face (scripts/labeler/hf_publish.py pull restores data/events);
# everything else is on /scratch ($LABELER_ROOT, /scratch/gpfs/EKOLEMEN/...).
# Rules are anchored with a leading `/` where they mean one place, and none is
# re-included with `!`.

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
/site/

# Environments and secrets
.venv/
/.pixi/
/envs/
.env
.envrc
.pypirc
**/.streamlit/secrets.toml
*.log

# Local agent and tool state: not part of the source
/.claude/
AGENTS.md
CLAUDE.md
CLAUDE.local.md
/.superpowers/
/.cache/
/.tmp/
/.tmp_*_cache/
/.vscode/
/wandb/

# Data, runs and large outputs
/data/
/outputs/
/runs/
/logs/
/checkpoints/
/eval_runs/
/scratch/
/profile/
/.smoke_*/
/core
# Weights, grids and records. The small fixtures under tests/ are tracked all
# the same: add a new one with `git add -f`.
*.pt
*.pth
*.ckpt
*.h5
*.mp4
*.npy
*.npz
